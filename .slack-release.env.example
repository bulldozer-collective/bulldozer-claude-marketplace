# Secrets du hook post-commit qui annonce les versions du plugin dans Slack.
# Copier en .slack-release.env (gitignore) et renseigner.
#
#   cp .slack-release.env.example .slack-release.env
#
# Bot token xoxb- de l'app Slack Bulldozer, scope chat:write, invitee dans le channel.
SLACK_BOT_TOKEN=
# Channel cible.
SLACK_CHANNEL_ID=C024D5KCSR0
